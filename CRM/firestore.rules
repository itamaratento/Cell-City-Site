rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // PÚBLICO: OS — leitura de doc único (garantia.html)
    // ─────────────────────────────────────────────
    match /os/{osId} {
      allow get:                           if true;
      allow list, create, update, delete:  if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // PÚBLICO: Config — leitura de doc único (garantia.html lê config/impressao)
    // ─────────────────────────────────────────────
    match /config/{docId} {
      allow get:                           if true;
      allow list, write:                   if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // PÚBLICO: Pré-OS — cliente cria sem login (abrir-atendimento.html)
    // ─────────────────────────────────────────────
    match /pre_os/{docId} {
      allow create:                        if true;
      allow read, update, delete:          if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // PRIVADO: Clientes e OS
    // ─────────────────────────────────────────────
    match /clientes/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /metadata/{docId} {
      allow read, write:                   if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // PRIVADO: Caixa e financeiro
    // ─────────────────────────────────────────────
    match /caixa_lancamentos/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /categorias_caixa/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /historico_diario/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /historico_semanal/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /historico_mensal/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /resumo_live/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /financeiro_pagar/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /financeiro_fixas/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /financeiro_receber/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /financeiro_categorias/{docId} {
      allow read, write:                   if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // PRIVADO: Estoque e fornecedores
    // ─────────────────────────────────────────────
    match /estoque_produtos/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /produtos/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /categorias_produtos/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /fornecedor_compras/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /fornecedor_tendencias/{docId} {
      allow read, write:                   if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // PRIVADO: Produtividade pessoal
    // ─────────────────────────────────────────────
    match /acoes_semana/{docId} {
      allow read, write:                   if request.auth != null;
    }

    // Agenda Inteligente — um documento por evento (calendário permanente)
    match /agenda/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /tarefas_semana/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /notas_usuarios/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /alarme_config/{docId} {
      allow read, write:                   if request.auth != null;
    }

    // Status (novo/lido/resolvido) dos alertas da Central de Alertas,
    // por usuário. O id do documento é sempre o próprio uid
    // (central-alertas.js usa doc(db, 'central_alertas_status', ctx.uid)) —
    // cada usuário só pode ler/escrever o seu próprio documento.
    match /central_alertas_status/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Barra de Favoritos (shared/favoritos.js). O id do documento é sempre
    // o próprio uid (favDocRef() -> doc(db, 'favoritos_usuarios', _uid)) —
    // cada usuário só pode ler/escrever o seu próprio documento.
    // H-002 (homologação 2026-07-03): coleção não tinha rule própria,
    // caía no deny-by-default do Firestore ("Missing or insufficient
    // permissions"). Pré-existente em produção, não introduzido pela
    // separação de ambientes.
    match /favoritos_usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ─────────────────────────────────────────────
    // PRIVADO: Base de conhecimento
    // ─────────────────────────────────────────────
    match /comandos/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /categorias_comandos/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /informacoes/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /categorias_informacoes/{docId} {
      allow read, write:                   if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // PRIVADO: Pós-venda e campanhas
    // ─────────────────────────────────────────────
    match /lembretes_pagamento/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /posvenda_contatos/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /posvenda_mensagens/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /posvenda_rastreamento/{docId} {
      allow read, write:                   if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // PRIVADO: Importações
    // ─────────────────────────────────────────────
    match /vendas_importadas/{docId} {
      allow read, write:                   if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // PRIVADO: Sincronização CRM ↔ Google Drive
    // Coleções usadas pelos módulos Tutoriais, Soluções Técnicas,
    // Diário Técnico. Operações via cc-sync.js / gdrive-backup.js.
    // ─────────────────────────────────────────────
    match /cc_lixeira/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /cc_gdrive_logs/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /gdrive_backup/{docId} {
      allow read, write:                   if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // KERNEL: Perfis de usuário e empresas
    // kernel.js lê/cria usuarios/{uid} em _buildContext()
    // Exceção aditiva (módulo Usuários e Permissões, 2026-07-01):
    // admin/master_admin também podem ler/escrever o doc de outros
    // usuários. A regra original (dono do próprio doc) continua intacta.
    // ─────────────────────────────────────────────
    match /usuarios/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil in ['admin', 'master_admin']
      );

      // BL-006 (homologação 2026-07-03): a regra antiga permitia que o
      // dono escrevesse QUALQUER campo do próprio doc, inclusive `perfil`
      // — o mesmo campo que todas as outras rules consultam para
      // autorizar admin. Isso permitia auto-escalação de privilégio
      // (comprovado: usuário comum virava master_admin com um PATCH
      // direto no Firestore, sem passar pela UI). Correção: criação do
      // próprio doc continua livre (auto-provisionamento do kernel.js
      // no primeiro login, _buildContext()); admin/master_admin mantêm
      // escrita total; o próprio dono só pode escrever campos NÃO
      // sensíveis — perfil, perfil_operacional_id, empresa_id e status
      // ficam congelados fora de admin.
      allow create: if request.auth != null && request.auth.uid == uid;

      allow update: if request.auth != null && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil in ['admin', 'master_admin'] ||
        (request.auth.uid == uid &&
         request.resource.data.get('perfil', null) == resource.data.get('perfil', null) &&
         request.resource.data.get('perfil_operacional_id', null) == resource.data.get('perfil_operacional_id', null) &&
         request.resource.data.get('empresa_id', null) == resource.data.get('empresa_id', null) &&
         request.resource.data.get('status', null) == resource.data.get('status', null))
      );

      allow delete: if request.auth != null && (
        request.auth.uid == uid ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil in ['admin', 'master_admin']
      );
    }

    match /empresas/{empId} {
      allow read: if request.auth != null;
      allow write: if false; // escrita apenas via Admin SDK / console
    }

    // Preferências por usuário (ex.: usuarios/{uid}/preferencias/modulos —
    // favoritos da Central de Módulos; usuarios/{uid}/preferencias/layout —
    // modoHome/sidebarCompacta). Cada usuário só acessa a própria subcoleção.
    match /usuarios/{uid}/preferencias/{prefId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ─────────────────────────────────────────────
    // MÓDULO: Usuários e Permissões (2026-07-01)
    // Catálogo de perfis operacionais (RBAC interno da empresa,
    // independente do 'perfil' de licenciamento SaaS do kernel.js/tenant.js).
    // Leitura liberada a qualquer autenticado (necessário para fases
    // futuras de checagem de permissão dentro dos módulos); escrita
    // restrita a admin/master_admin.
    // ─────────────────────────────────────────────
    match /perfis_operacionais/{perfilId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil in ['admin', 'master_admin'];
    }

    // Log de auditoria do módulo — imutável (nunca editado/apagado),
    // leitura e criação restritas a admin/master_admin.
    match /auditoria_usuarios_permissoes/{logId} {
      allow read, create: if request.auth != null &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil in ['admin', 'master_admin'];
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────
    // PRIVADO: CRM Comercial — leads/pré-orçamentos
    // ─────────────────────────────────────────────
    match /crm_leads/{docId} {
      allow read, write:                   if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // DIAGNÓSTICO: Documento temporário do kernel-test
    // ─────────────────────────────────────────────
    match /_diagnostico_temp/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ─────────────────────────────────────────────
    // PRIVADO: Dashboard — coleções de analytics e portal
    // ─────────────────────────────────────────────
    match /avaliacoes/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /diario_registros/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /estoque/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /mensagens_portal/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /portal_eventos/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /agendamentos/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /solicitacoes_diagnostico/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /catalogo_produtos/{docId} {
      allow read, write:                   if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // BLOQUEADO: Coleções legadas — nunca usadas pelos módulos
    // ─────────────────────────────────────────────
    match /orders/{docId} {
      allow read, write:                   if false;
    }

    match /clients/{docId} {
      allow read, write:                   if false;
    }

  }
}