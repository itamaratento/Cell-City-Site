rules_version = '2';

// ⚠️ REGRAS TEMPORÁRIAS ABERTAS — restauradas para manter o app funcionando.
// A versão SEGURA (request.auth != null) está pronta em CRM/firestore.rules.secure
// e só pode ser publicada APÓS habilitar "Anonymous" em:
//   Firebase Console → Authentication → Sign-in method → Anonymous → Enable
// Depois: copiar firestore.rules.secure para firestore.rules e rodar:
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
