rules_version = '2';

// PS-6 (multiempresa): padrão canônico de path é empresas/{empresaId}/...
// — todo upload novo é namespaced pela empresa do usuário (validada via
// cross-service lookup no Firestore). Os paths legados (os/, docs/),
// anteriores à PS-6, continuam legíveis para não quebrar as URLs já
// gravadas nos documentos; pertencem todos à Cell City (única empresa
// da era single-tenant). O catch-all antigo (qualquer autenticado lia
// e escrevia em QUALQUER path do bucket) foi removido — deny-by-default.
//
// FASE 4.1: leitura de fotos de OS deixou de ser pública (`if true`).
// URLs de download já emitidas (com token) continuam válidas; novas
// leituras via SDK exigem auth + mesma empresa. Portal/garantia usam
// campos projetados pelas Cloud Functions, não getDownloadURL anônimo.
service firebase.storage {
  match /b/{bucket}/o {

    // Null-safe: doc ausente nao derruba avaliacao com Null value error.
    function empresaDoUsuario() {
      return request.auth != null
             && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid))
             ? firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.get('empresa_id', null)
             : null;
    }

    // ── CANÔNICO: fotos de OS por empresa ─────────────────────
    match /empresas/{empresaId}/os/{osId}/{allPaths=**} {
      allow read:   if request.auth != null && empresaDoUsuario() == empresaId;
      allow write:  if request.auth != null
                    && empresaDoUsuario() == empresaId
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && empresaDoUsuario() == empresaId;
    }

    // ── CANÔNICO: demais arquivos por empresa (docs internos etc.) ──
    match /empresas/{empresaId}/{allPaths=**} {
      allow read, delete: if request.auth != null && empresaDoUsuario() == empresaId;
      allow write:        if request.auth != null
                          && empresaDoUsuario() == empresaId
                          && request.resource.size < 20 * 1024 * 1024;
    }

    // ── LEGADO (pré-PS-6): fotos de OS da Cell City ───────────
    // FASE 4.1: read autenticado + empresa dona (cellcity-master).
    match /os/{osId}/{allPaths=**} {
      allow read:   if request.auth != null && empresaDoUsuario() == 'cellcity-master';
      allow write:  if false;
      allow delete: if request.auth != null && empresaDoUsuario() == 'cellcity-master';
    }

    // ── LEGADO (pré-PS-6): documentos da Central de Informações ──
    match /docs/{allPaths=**} {
      allow read:   if request.auth != null;
      allow delete: if request.auth != null && empresaDoUsuario() == 'cellcity-master';
      allow write:  if false;
    }
  }
}
