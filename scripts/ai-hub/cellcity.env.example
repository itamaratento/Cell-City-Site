# Cell City AI Hub — Template de Variáveis de Ambiente
# Copie para ~/.gemini/config/cellcity.env e proteja com: chmod 600 ~/.gemini/config/cellcity.env
# NUNCA commite o arquivo .env real no GitHub nem compartilhe em chat!

# --- Nível 1: Cursor CLI Headless (Programador Principal) ---
# Obtenha em: https://cursor.com/dashboard -> Integrations -> User API Keys
# Alternativa interativa no terminal: `agent login`
CURSOR_API_KEY=COLE_SUA_CHAVE_CURSOR_AQUI

# --- Nível 2: DP/DeepSeek API (Segundo Programador) ---
# Obtenha em: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=COLE_SUA_CHAVE_DEEPSEEK_AQUI
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- Repositório Local Principal ---
CELLCITY_REPO=/home/antigravity/Cell-City-Site
