# Logs
logs
*.log

# Cell City Control Center — a pasta logs/ faz parte da estrutura oficial
# (scripts/control-center/README.md), mas o conteúdo em runtime (*.log)
# continua ignorado pelas regras acima. Só o .gitkeep é versionado.
!scripts/control-center/logs/
!scripts/control-center/logs/.gitkeep

# Cell City V3 — mesmo problema: a pasta logs/ do NOC V3 guarda o
# logger.sh (código-fonte do motor de logging), não só logs de runtime.
# A regra bare "logs" acima ignorava a pasta inteira, então logger.sh nunca
# foi versionado (achado durante conexão de config/v3.conf, 2026-07-15) —
# noc.sh/kernel.sh fazem `source .../logs/logger.sh` sem fallback, então
# qualquer checkout novo sem este arquivo local ficaria com o NOC quebrado.
# noc.log/events.log continuam ignorados pela regra *.log acima.
!scripts/control-center/v3/logs/
!scripts/control-center/v3/logs/logger.sh
!scripts/control-center/v3/logs/.gitkeep
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log*
firebase-debug.*.log*

# Firebase cache
.firebase/

# Firebase config

# Uncomment this if you'd like others to create their own Firebase project.
# For a team working on the same Firebase project(s), it is recommended to leave
# it commented so all members can deploy to the same project(s) in .firebaserc.
# .firebaserc

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env

# dataconnect generated files
.dataconnect
sa-key.json
sa-key-dev.json

# Backups locais (repositorios git aninhados, nao devem ir pro GitHub)
_BACKUPS/

# Evidencias geradas por scripts/homologacao (screenshots/logs por execucao —
# nao sao codigo-fonte, nao devem inchar o repositorio)
evidencias/

# Auditorias com detalhe técnico explorável de vulnerabilidade aberta —
# nunca publicar (plans/ é servido ao vivo no site via GitHub Pages).
# Convenção: sufixo _INTERNO.md em plans/ = não versionar.
plans/*_INTERNO.md

# Artefatos de teste/debug na raiz
teste*.txt
how*

# Cell City Control Center — relatórios exportados em runtime (módulos
# Ferramentas e Banco de Dados, ver scripts/control-center/README.md) e
# config local por módulo (preferências do desenvolvedor, nunca dado de
# negócio) — nenhum dos dois é código-fonte, nunca deve ir pro repositório.
_reports/
scripts/control-center/modules/*/config/local.json

# Runtime state files — modificados a cada execucao do NOC/health-engine.
# Apenas o .gitkeep e o snapshot inicial sao versionados; o resto e ruido.
scripts/control-center/v3/state/*.json
!scripts/control-center/v3/state/.gitkeep
scripts/health-engine/state/health-check.json
scripts/observability/state/*.json
!scripts/observability/state/.gitkeep
scripts/prompt-generator/state/

