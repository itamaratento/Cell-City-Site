rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // PÚBLICO (clientes sem login) — acesso mínimo necessário
    // ─────────────────────────────────────────────

    // Consulta de garantia: leitura de uma OS específica (garantia.html)
    match /os/{osId} {
      allow get: if true;
    }

    // Layout de impressão usado na garantia (garantia.html lê config/impressao).
    // Escopo restrito ao doc "impressao" — NÃO expõe config/pin nem outros docs.
    match /config/impressao {
      allow get: if true;
    }

    // Abertura de atendimento pelo cliente, sem login (abrir-atendimento.html)
    match /pre_os/{docId} {
      allow create: if true;
    }

    // Catálogo público — leitura de produtos ativos e configurações (sem login)
    match /catalogo_produtos/{docId} {
      allow read: if true;
    }
    match /catalogo_config/{docId} {
      allow read: if true;
    }

    // ─────────────────────────────────────────────
    // SINCRONIZAÇÃO CRM ↔ GOOGLE DRIVE
    // Coleções de suporte usadas pelos módulos Tutoriais, Soluções Técnicas,
    // Diário Técnico e futuros. Operações via cc-sync.js / gdrive-backup.js.
    // ─────────────────────────────────────────────

    // Lixeira global: armazena snapshots de registros excluídos (retenção 30 dias).
    // Operações: enviarParaLixeira (setDoc), listarLixeira (getDocs),
    // removerDaLixeira (deleteDoc), purgarLixeira (getDocs + deleteDoc).
    match /cc_lixeira/{docId} {
      allow read, write: if request.auth != null;
    }

    // Log de auditoria: registro de ações de sincronização.
    // Operação atual: registrarLog (addDoc). Futuro: leitura para admin.
    match /cc_gdrive_logs/{docId} {
      allow read, write: if request.auth != null;
    }

    // Configuração do Google Drive: Client ID global + configuração por módulo.
    // Operações: carregarCreds/carregarCfg (getDoc), salvarCreds/salvarCfg (setDoc).
    match /gdrive_backup/{docId} {
      allow read, write: if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // PRIVADO — todo o restante exige usuário autenticado.
    // O app autentica anonimamente em CRM/scripts/firebase.js, então
    // todas as páginas internas (Caixa, Estoque, Dashboard, Agenda, OS,
    // config/pin, etc.) continuam funcionando.
    // ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

  }
}
