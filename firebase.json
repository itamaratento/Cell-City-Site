{
  "firestore": {
    "database": "(default)",
    "location": "southamerica-east1",
    "rules": "CRM/firestore.rules",
    "indexes": "CRM/firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs20"
    }
  ],
  "hosting": {
    "public": "CRM",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/favicon.ico",
        "headers": [{ "key": "Content-Type", "value": "image/png" }]
      },
      {
        "source": "/**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "img-src 'self' data: https:;"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/portal",
        "destination": "/pages/portal-cliente/index.html"
      },
      {
        "source": "/portal/**",
        "destination": "/pages/portal-cliente/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
