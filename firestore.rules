rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // PÚBLICO: OS — leitura de doc único (garantia.html)
    // ─────────────────────────────────────────────
    match /os/{osId} {
      allow get:                           if true;
      allow list, create, update, delete:  if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // PÚBLICO: Config — leitura de doc único (garantia.html lê config/impressao)
    // ─────────────────────────────────────────────
    match /config/{docId} {
      allow get:                           if true;
      allow list, write:                   if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // PÚBLICO: Pré-OS — cliente cria sem login (abrir-atendimento.html)
    // ─────────────────────────────────────────────
    match /pre_os/{docId} {
      allow create:                        if true;
      allow read, update, delete:          if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // PÚBLICO: Portal — cliente lê eventos e mensagens
    // ─────────────────────────────────────────────
    match /portal_eventos/{docId} {
      allow create:                        if true;
      allow read, update, delete:          if request.auth != null;
    }

    match /mensagens_portal/{docId} {
      allow create:                        if true;
      allow read, update, delete:          if request.auth != null;
    }

    match /solicitacoes_diagnostico/{docId} {
      allow create:                        if true;
      allow read, update, delete:          if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // PRIVADO: Clientes e OS
    // ─────────────────────────────────────────────
    match /clientes/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /crm_leads/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /metadata/{docId} {
      allow read, write:                   if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // PRIVADO: Caixa e financeiro
    // ─────────────────────────────────────────────
    match /caixa_lancamentos/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /lancamentos_caixa/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /categorias_caixa/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /historico_diario/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /historico_semanal/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /historico_mensal/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /resumo_live/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /financeiro_pagar/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /financeiro_fixas/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /financeiro_receber/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /financeiro_categorias/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /financeiro_cat_despesas/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /pendencias/{docId} {
      allow read, write:                   if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // PRIVADO: Estoque e fornecedores
    // ─────────────────────────────────────────────
    match /estoque_produtos/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /estoque_config/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /estoque_movimentacoes/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /produtos/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /categorias_produtos/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /fornecedor_compras/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /fornecedor_tendencias/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /fornecedores/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /encomendas/{docId} {
      allow read, write:                   if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // PRIVADO: Produtividade pessoal
    // ─────────────────────────────────────────────
    match /acoes_semana/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /agenda/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /tarefas_semana/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /notas_usuarios/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /alarme_config/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /alertas_usuario/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /historico_alertas/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /central_alertas_status/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /central_organizacao/{docId} {
      allow read, write:                   if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // PRIVADO: Base de conhecimento
    // ─────────────────────────────────────────────
    match /comandos/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /categorias_comandos/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /informacoes/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /categorias_informacoes/{docId} {
      allow read, write:                   if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // PRIVADO: Pós-venda e campanhas
    // ─────────────────────────────────────────────
    match /lembretes_pagamento/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /posvenda_contatos/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /posvenda_mensagens/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /posvenda_rastreamento/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /categorias_wpp/{docId} {
      allow read, write:                   if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // PRIVADO: Diário técnico
    // ─────────────────────────────────────────────
    match /diario_registros/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /diario_eventos/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /diario_metas/{docId} {
      allow read, write:                   if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // PRIVADO: Chat interno
    // ─────────────────────────────────────────────
    match /chat_historico/{docId} {
      allow read, write:                   if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // PRIVADO: Importações
    // ─────────────────────────────────────────────
    match /vendas_importadas/{docId} {
      allow read, write:                   if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // PRIVADO: Sincronização CRM ↔ Google Drive
    // ─────────────────────────────────────────────
    match /cc_lixeira/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /cc_gdrive_logs/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /gdrive_backup/{docId} {
      allow read, write:                   if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // PRIVADO: Backup e auditoria
    // ─────────────────────────────────────────────
    match /backup_historico/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /backup_logs/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /auditoria_logs/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /lixeira/{docId} {
      allow read, write:                   if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // PRIVADO: Automação
    // ─────────────────────────────────────────────
    match /automacao_execucoes/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /automacao_logs/{docId} {
      allow read, write:                   if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // PRIVADO: Robô WhatsApp
    // ─────────────────────────────────────────────
    match /robo_atividade/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /tarefas_robo/{docId} {
      allow read, write:                   if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // PRIVADO: Monitoramento e configurações gerais
    // ─────────────────────────────────────────────
    match /monitoramento/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /configuracoes/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /preferencias_sistema/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /favoritos_usuarios/{docId} {
      allow read, write:                   if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // PRIVADO: SaaS residual (dados existentes, sem uso ativo)
    // ─────────────────────────────────────────────
    match /usuarios/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /empresas/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /assinaturas/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /auditoria_saas/{docId} {
      allow read, write:                   if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // PRIVADO: Temporários / debug
    // ─────────────────────────────────────────────
    match /teste_caixa/{docId} {
      allow read, write:                   if request.auth != null;
    }

    match /_diagnostico_temp/{docId} {
      allow read, write:                   if request.auth != null;
    }

    // ─────────────────────────────────────────────
    // BLOQUEADO: Coleções legadas
    // ─────────────────────────────────────────────
    match /orders/{docId} {
      allow read, write:                   if false;
    }

    match /clients/{docId} {
      allow read, write:                   if false;
    }

  }
}
